# Let git decide for anything not listed explicitly below.
* text=auto

# ---------------------------------------------------------------------------
# Unity YAML
# ---------------------------------------------------------------------------
# These are text and should stay diffable. The scenes in this project are large
# (~34 MB each), so keeping them text is what makes "what changed?" answerable
# at all.
#
# merge=unityyamlmerge asks git to use Unity's Smart Merge tool. If it is not
# configured git silently falls back to the normal text merge, so this is safe
# to leave in. To enable it:
#   git config merge.unityyamlmerge.name "Unity SmartMerge"
#   git config merge.unityyamlmerge.driver '"C:/Program Files/Unity/Hub/Editor/6000.3.10f1/Editor/Data/Tools/UnityYAMLMerge.exe" merge -p %O %A %B %A'
*.unity           merge=unityyamlmerge eol=lf
*.prefab          merge=unityyamlmerge eol=lf
*.asset           merge=unityyamlmerge eol=lf
*.mat             merge=unityyamlmerge eol=lf
*.anim            merge=unityyamlmerge eol=lf
*.controller      merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.physicMaterial  merge=unityyamlmerge eol=lf
*.physicsMaterial2D merge=unityyamlmerge eol=lf
*.playable        merge=unityyamlmerge eol=lf
*.mask            merge=unityyamlmerge eol=lf
*.brush           merge=unityyamlmerge eol=lf
*.flare           merge=unityyamlmerge eol=lf
*.terrainlayer    merge=unityyamlmerge eol=lf
*.meta            merge=unityyamlmerge eol=lf

# Source
*.cs              text diff=csharp eol=lf
*.shader          text eol=lf
*.hlsl            text eol=lf
*.cginc           text eol=lf
*.json            text eol=lf
*.md              text eol=lf
*.gitignore       text eol=lf
*.gitattributes   text eol=lf

# ---------------------------------------------------------------------------
# Git LFS - large binary art
# ---------------------------------------------------------------------------
# UNS_HDRI.hdr alone is 250 MB, which is over GitHub's hard 100 MB per-file
# limit - a plain git push would be rejected outright. These types are stored
# in LFS from the very first commit, because retrofitting LFS later requires
# rewriting history.
#
# Scenes and prefabs deliberately stay OUT of LFS: they are text, they change
# constantly, and keeping them in normal git is what makes them diffable.
*.hdr    filter=lfs diff=lfs merge=lfs -text
*.exr    filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.FBX    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.obj    filter=lfs diff=lfs merge=lfs -text
*.dae    filter=lfs diff=lfs merge=lfs -text
*.3ds    filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.tga    filter=lfs diff=lfs merge=lfs -text
*.tif    filter=lfs diff=lfs merge=lfs -text
*.tiff   filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text
*.gif    filter=lfs diff=lfs merge=lfs -text
*.bmp    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text
*.ogg    filter=lfs diff=lfs merge=lfs -text
*.aif    filter=lfs diff=lfs merge=lfs -text
*.mp4    filter=lfs diff=lfs merge=lfs -text
*.mov    filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Binary - not worth LFS, but never line-ending converted or diffed as text
# ---------------------------------------------------------------------------
*.ttf             binary
*.otf             binary
*.dll             binary
*.so              binary
*.dylib           binary
*.a               binary
*.pdf             binary
*.zip             binary
